# Server Port
PORT=5000

# Environment
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/jira_task_manager?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:admin123@cluster0.mongodb.net/jira_task_manager?retryWrites=true&w=majority

# JWT Secrets & Expiry
JWT_SECRET=super_secret_production_jwt_key_jira_pro_2026_xyz
JWT_EXPIRE=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Upload settings
MAX_FILE_SIZE_MB=10

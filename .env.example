# ==========================================
# JiraFlow Environment Configuration
# ==========================================

# Port Configuration
PORT=5000
NODE_ENV=development

# ------------------------------------------
# MongoDB Atlas Connection URI (Preferred)
# Replace <username>, <password>, and cluster URL with your Atlas credentials:
# ------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/jira_task_manager?retryWrites=true&w=majority

# Fallback Local MongoDB (if running locally or inside docker)
# MONGODB_URI=mongodb://127.0.0.1:27017/jira_task_manager

# ------------------------------------------
# Security & JWT Token Secrets
# ------------------------------------------
JWT_SECRET=production_ultra_secure_jwt_secret_key_jira_pro_2026_xyz!@#
JWT_EXPIRE=7d

# ------------------------------------------
# Client URL (for CORS validation)
# ------------------------------------------
CLIENT_URL=http://localhost:5173

# ------------------------------------------
# File Upload Configuration
# ------------------------------------------
MAX_FILE_SIZE_MB=15
